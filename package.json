{
  "name": "blog",
  "version": "0.4.0",
  "description": "Distraction-free blogging experience. Made for everyone.",
  "productName": "Legendword Blog",
  "author": "Legendword <zwh@legendword.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "quasar dev",
    "build": "quasar build",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\" \"./test/**/*.js\" --fix",
    "lint:check": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\" \"./test/**/*.js\"",
    "test": "echo \"See package.json => scripts for available tests.\" && exit 0",
    "test:unit": "vitest run",
    "test:unit:ci": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "start-server-and-test \"quasar dev\" http-get://localhost:8080 \"cypress open --e2e\"",
    "test:e2e:ci": "start-server-and-test \"quasar dev\" http-get://localhost:8080 \"cypress run --e2e\"",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mdit/plugin-tex": "^1.3.0",
    "@quasar/extras": "^2.1.0",
    "asciimath-to-latex": "^0.5.1",
    "axios": "^1.21.1",
    "dompurify": "^3.4.18",
    "echarts": "^6.1.0",
    "flowchart.js": "^1.18.1",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.3.0",
    "pinia": "^4.1.0",
    "quasar": "^2.35.5",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.10.4",
    "@quasar/quasar-app-extension-testing-unit-vitest": "^3.0.1",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "autoprefixer": "^10.6.2",
    "cypress": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.4.0",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.8",
    "start-server-and-test": "^3.0.13",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.0"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.6",
      "editorconfig": {
        "minimatch": "^11.0.9"
      }
    }
  },
  "engines": {
    "node": ">= 26 || ^24 || ^22.22"
  }
}
